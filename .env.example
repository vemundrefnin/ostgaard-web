# Alle variabler er valgfrie. Siden bygger og kjører uten noen av dem.

# Kanonisk adresse. Brukes i sitemap, canonical-lenker, Open Graph og llms.txt.
# Settes i Vercel for Production. Preview-deploys bruker sin egen URL automatisk.
NEXT_PUBLIC_SITE_URL=https://garder-ostgaard.no

# Sett til "true" i Vercel Production FØRST når garder-ostgaard.no peker hit.
# Før det skal ingen søkemotor indeksere siden (den konkurrerer med Wix-siden).
SITE_INDEXABLE=false

# PostHog (EU). Uten nøkkel lastes ingen analytics-kode i det hele tatt.
NEXT_PUBLIC_POSTHOG_KEY=

# Adressen Wix-siten (billetter, gavekort, dagens skjema) svarer på. Settes til
# f.eks. https://booking.garder-ostgaard.no den dagen garder-ostgaard.no pekes
# hit, ellers peker billettlenkene tilbake på denne siden.
NEXT_PUBLIC_WIX_URL=https://www.garder-ostgaard.no

# Visningsskjemaet leverer til kjøreplan-appen (POST /api/public/henvendelse).
# Samme PUBLIC_FORM_SECRET må ligge i Vercel for BEGGE prosjekter. Uten disse
# viser skjemaet e-post og telefon i stedet for å sende.
PLAN_API_URL=https://plan.garder-ostgaard.no
PUBLIC_FORM_SECRET=

# Wix Events (kommende arrangementer på forsiden). Lages under
# manage.wix.com/account/api-keys med tillatelsen «Wix Events: Read Events».
# Site ID står i Wix-dashbordet under Settings → Business info, eller i URL-en.
# Uten nøkkel brukes src/content/events.json.
WIX_API_KEY=
WIX_SITE_ID=

# Alle variabler er valgfrie. Siden bygger og kjører uten noen av dem.

# Kanonisk adresse. Brukes i sitemap, canonical-lenker, Open Graph og llms.txt.
# Settes i Vercel for Production. Preview-deploys bruker sin egen URL automatisk.
NEXT_PUBLIC_SITE_URL=https://garder-ostgaard.no

# Sett til "true" i Vercel Production FØRST når garder-ostgaard.no peker hit.
# Før det skal ingen søkemotor indeksere siden (den konkurrerer med Wix-siden).
SITE_INDEXABLE=false

# PostHog (EU). Uten nøkkel lastes ingen analytics-kode i det hele tatt.
NEXT_PUBLIC_POSTHOG_KEY=
